rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Car photos are uploaded client-side (components/AddCarModal.tsx) by a
    // signed-in admin — there's no public sign-up, so request.auth != null
    // means "an admin is logged in". Reads stay open: the resulting
    // download-token URLs need to load for anyone visiting the site, and
    // getDownloadURL() itself requires a read to fetch the token in the
    // first place.
    match /cars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hero image uploaded from app/dashboard/settings/page.tsx.
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
