rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public contact form (components/ContactSection.tsx) writes here directly
    // with the client SDK. Anyone can create a well-shaped lead; nobody can
    // read, update, or delete from the client — the dashboard reads/deletes
    // through the Admin SDK, which always bypasses these rules.
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if false;
    }

    // Public inventory. Anyone can read (the marketing site and car detail
    // pages need it); only a signed-in admin can create/update — there's no
    // public sign-up, so request.auth != null means "an admin is logged in".
    // Deletes go through the dashboard's Server Action (Admin SDK, bypasses
    // this file entirely) rather than a client-side rule.
    match /cars/{carId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
